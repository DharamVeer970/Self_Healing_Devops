# Portfolio Watchdog (Render API)
RENDER_API_KEY=
RENDER_SERVICE_ID=srv-xxxxxxxxxxxx

# Copy this file to ".env" and fill in what you use.
# NEVER commit the real .env - it is gitignored on purpose.

# ---- LLM (optional, either one) -------------------------------------------
TOKENROUTER_API_KEY=
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-4o-mini

# ---- Slack notifications (optional) ---------------------------------------
SLACK_WEBHOOK_URL=

# ---- Email notifications via SMTP (optional, all fields required) ---------
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_TO=
EMAIL_FROM=
