# Portfolio Watchdog (Render API)
RENDER_API_KEY=
RENDER_BACKEND_TRADING_SERVICE_ID=srv-xxxxxxxxxxxx
RENDER_FRONTEND_TRADING_SERVICE_ID=srv-xxxxxxxxxxxx
RENDER_BACKEND_PORTFOLIO_SERVICE_ID=srv-xxxxxxxxxxxx
WATCHDOG_APP_URL=
WATCHDOG_FRONTEND_URL=
WATCHDOG_PORTFOLIO_BACKEND_URL=

# Set to 1 only if you accept the token cost of probing every cycle.
WATCHDOG_CHAT_PROBE=0

# ---- URL Connectivity Checker -----------------------------------------------
# The 3 Render URLs above (WATCHDOG_*) are the single source of truth.
CHECK_INTERVAL=120
CHECK_TIMEOUT=10

# ---- Script Writer Agent ----------------------------------------------------
SCRIPT_FIX_DIR=
# Set to 1 to enable dry-run mode (shows what WOULD be written without writing).
SCRIPT_DRY_RUN=0
# Source patching is OFF by default EVERYWHERE and forced OFF on GitHub
SCRIPT_PATCH_SOURCE=0
# Leave as 0. Only set to 1 for throwaway sandbox CI jobs that may rewrite
ALLOW_SOURCE_PATCH_IN_CI=0

# ---- LLM (optional, either one) -------------------------------------------
TOKENROUTER_API_KEY=
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-4o-mini

# ---- Slack notifications (optional) ---------------------------------------
SLACK_WEBHOOK_URL=

# ---- Email notifications via SMTP (optional, all fields required) ---------
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_TO=
EMAIL_FROM=
