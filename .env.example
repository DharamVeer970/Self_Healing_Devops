# Portfolio Watchdog (Render API)
RENDER_API_KEY=
RENDER_SERVICE_ID=srv-xxxxxxxxxxxx
# Target URL (optional; defaults to the portfolio backend). Override for other apps.
WATCHDOG_APP_URL=https://dharam-portfolio-api.onrender.com
# OPT-IN on purpose: the /chat probe bills your chat + reranker providers.
# Set to 1 only if you accept the token cost of probing every cycle.
WATCHDOG_CHAT_PROBE=0
WATCHDOG_CHAT_QUERY=What has Dharam built?

# Copy this file to ".env" and fill in what you use.

# ---- LLM (optional, either one) -------------------------------------------
TOKENROUTER_API_KEY=
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-4o-mini

# ---- Slack notifications (optional) ---------------------------------------
SLACK_WEBHOOK_URL=

# ---- Email notifications via SMTP (optional, all fields required) ---------
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_TO=
EMAIL_FROM=
